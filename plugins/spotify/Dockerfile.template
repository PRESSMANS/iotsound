FROM balenalib/armv7hf-debian:bullseye as builder

RUN install_packages \
    curl \
    build-essential \
    libasound2-dev \
    libpulse-dev \
    pkg-config \
    git \
    cmake \
    clang \
    libclang-dev

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

RUN git clone --depth 1 --branch v0.5.0 https://github.com/librespot-org/librespot.git /build/librespot

WORKDIR /build/librespot

# 利用可能なフィーチャーを確認してからビルド
RUN cat Cargo.toml | grep -A 50 '\[features\]'

RUN sed -i 's/aws-lc-rs/ring/g' Cargo.toml && \
    sed -i 's/aws-lc-rs/ring/g' core/Cargo.toml 2>/dev/null || true

RUN cargo build --release \
    --no-default-features \
    --features pulseaudio-backend

FROM balenalib/armv7hf-debian:bullseye

RUN install_packages libpulse0

COPY --from=builder /build/librespot/target/release/librespot /usr/bin/librespot

ENV PULSE_SERVER=tcp:localhost:4317

COPY start.sh /usr/src/

CMD [ "/bin/bash", "/usr/src/start.sh" ]
